@using System.Text.Json
@using BeachSA.Web.Models

@{
    // Obtener el menú autorizado desde la autenticación
    var menuJson = User.FindFirst("Menu")?.Value;

    // Preparar las opciones del menú para cuando exista la API
    var opcionesMenu = new List<MenuItemResponse>();

    if (!string.IsNullOrWhiteSpace(menuJson))
    {
        try
        {
            opcionesMenu = JsonSerializer.Deserialize<List<MenuItemResponse>>(
                menuJson,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }
            ) ?? new List<MenuItemResponse>();
        }
        catch (JsonException)
        {
            // Si el formato no es válido, dejar la lista vacía
            opcionesMenu = new List<MenuItemResponse>();
        }
    }

    // Temporal: mostrar todas las opciones durante el desarrollo.
    // Cuando exista la API, se utilizará opcionesMenu.
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <!-- CONFIGURACIÓN RESPONSIVA -->
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <!-- TÍTULO DE LA PÁGINA -->
    <title>@ViewData["Title"] - Beach S.A.</title>

    <!-- ESTILOS DE BOOTSTRAP -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <!-- ESTILOS PERSONALIZADOS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/BeachSA.Web.styles.css"
          asp-append-version="true" />

    <!-- ESTILOS DE LA BARRA DE NAVEGACIÓN -->
    <style>

        /* ESTRUCTURA DE LA NAVEGACIÓN */
        @@media (min-width: 992px) {

            .beach-navbar-content {
                position: relative;
                min-height: 70px;
            }

            /* CENTRAR LAS OPCIONES DEL MENÚ */
            .beach-main-menu {
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.25rem;
                white-space: nowrap;
            }

            /* MANTENER LA AUTENTICACIÓN A LA DERECHA */
            .beach-user-menu {
                margin-left: auto;
            }
        }

        /* ESTILO DE LOS ENLACES */
        .beach-main-menu .nav-link {
            font-weight: 500;
            padding-left: 0.65rem !important;
            padding-right: 0.65rem !important;
            transition: color 0.2s ease;
        }

        .beach-main-menu .nav-link:hover {
            color: #ffffff !important;
        }

        /* AJUSTES PARA DISPOSITIVOS MÓVILES */
        @@media (max-width: 991.98px) {

            .beach-main-menu {
                text-align: center;
                margin-top: 1rem;
            }

            .beach-user-menu {
                text-align: center;
                margin-top: 1rem;
                padding-bottom: 0.75rem;
            }

            .beach-user-menu .nav-link {
                justify-content: center;
            }
        }

    </style>

</head>

<body class="d-flex flex-column min-vh-100">

    <!-- BARRA DE NAVEGACIÓN PRINCIPAL -->
    <header>

        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm"
             style="background-color: var(--beach-navy, #123B5D);">

            <div class="container-fluid px-4">

                <!-- LOGO DE BEACH S.A. -->
                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/BeachLogo.png"
                         alt="Logo Beach S.A."
                         width="100"
                         height="70"
                         style="object-fit: contain;"
                         asp-append-version="true" />

                    <span class="fw-bold fs-4">Beach S.A.</span>

                </a>

                <!-- BOTÓN DEL MENÚ RESPONSIVO -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarPrincipal"
                        aria-controls="navbarPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- CONTENIDO DE LA NAVEGACIÓN -->
                <div class="collapse navbar-collapse beach-navbar-content"
                     id="navbarPrincipal">

                    <!-- MENÚ PRINCIPAL CENTRADO -->
                    <ul class="navbar-nav beach-main-menu mb-2 mb-lg-0">

                        <!-- INICIO -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        <!-- CLIENTES -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Clientes"
                               asp-action="Index">
                                Clientes
                            </a>
                        </li>

                        <!-- PAQUETES -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Paquete"
                               asp-action="Index">
                                Paquetes
                            </a>
                        </li>

                        <!-- RESERVACIONES -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Reservacion"
                               asp-action="Index">
                                Reservaciones
                            </a>
                        </li>

                        <!-- USUARIOS -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Usuarios"
                               asp-action="Index">
                                Usuarios
                            </a>
                        </li>

                        <!-- ROLES -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Roles"
                               asp-action="Index">
                                Roles
                            </a>
                        </li>

                        <!-- AUDITORÍA -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Auditoria"
                               asp-action="Index">
                                Auditoría
                            </a>
                        </li>

                    </ul>

                    <!-- SECCIÓN DE AUTENTICACIÓN -->
                    <ul class="navbar-nav beach-user-menu align-items-lg-center gap-lg-2">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- INFORMACIÓN DEL USUARIO -->
                            <li class="nav-item">

                                <span class="nav-link text-white d-flex align-items-center gap-2">

                                    <img src="~/images/UserIcon.png"
                                         alt="Usuario"
                                         width="25"
                                         height="25"
                                         style="object-fit: contain;"
                                         asp-append-version="true" />

                                    @(User.FindFirst("FullName")?.Value
                                        ?? User.Identity.Name)

                                </span>

                            </li>

                            <!-- CERRAR SESIÓN -->
                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm">
                                        Cerrar sesión
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- INICIAR SESIÓN -->
                            <li class="nav-item">

                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="btn btn-outline-light btn-sm">
                                    Iniciar sesión
                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main role="main"
          class="container-fluid px-4 py-4 flex-grow-1">

        @RenderBody()

    </main>

    <!-- PIE DE PÁGINA -->
    <footer class="border-top py-3 mt-auto bg-light">

        <div class="container-fluid px-4 text-center text-secondary">

            <small>
                &copy; @DateTime.Now.Year - Beach S.A.
            </small>

        </div>

    </footer>

    <!-- SCRIPTS DE BOOTSTRAP -->
    <script src="~/lib/jquery/dist/jquery.min.js"
            asp-append-version="true"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-append-version="true"></script>

    <!-- SCRIPTS PERSONALIZADOS -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- SCRIPTS ADICIONALES DE LAS VISTAS -->
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
