@model BeachSA.Web.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<!-- SECCIÓN PRINCIPAL DE ELIMINACIÓN -->
<section class="container-fluid">

    <!-- ENCABEZADO DE LA PÁGINA -->
    <div class="mb-4">

        <h1 class="fw-bold mb-1">
            Eliminar Cliente
        </h1>

        <p class="text-secondary">
            Confirme la operación sobre el cliente seleccionado.
        </p>

    </div>

    <!-- TARJETA DE CONFIRMACIÓN -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <!-- MENSAJE DE ADVERTENCIA -->
            <div class="alert alert-warning" role="alert">

                <strong>Atención:</strong>
                ¿Está seguro de que desea eliminar este cliente?

                <p class="mb-0 mt-2">
                    Si el cliente tiene reservaciones asociadas,
                    el sistema conservará su información y
                    lo marcará como inactivo.
                </p>

            </div>

            <!-- INFORMACIÓN DEL CLIENTE -->
            <h5 class="fw-bold mb-3">
                Cliente seleccionado
            </h5>

            <div class="row">

                <!-- TIPO DE CÉDULA -->
                <div class="col-md-6 mb-3">

                    <label class="fw-semibold d-block">
                        Tipo de cédula
                    </label>

                    <span class="text-secondary">
                        @Model.TipoCedula
                    </span>

                </div>

                <!-- CÉDULA -->
                <div class="col-md-6 mb-3">

                    <label class="fw-semibold d-block">
                        Cédula
                    </label>

                    <span class="text-secondary">
                        @Model.Cedula
                    </span>

                </div>

                <!-- NOMBRE COMPLETO -->
                <div class="col-md-12 mb-3">

                    <label class="fw-semibold d-block">
                        Nombre completo
                    </label>

                    <span class="text-secondary">
                        @Model.NombreCompleto
                    </span>

                </div>

                <!-- CORREO ELECTRÓNICO -->
                <div class="col-md-6 mb-3">

                    <label class="fw-semibold d-block">
                        Correo electrónico
                    </label>

                    <span class="text-secondary">
                        @Model.Email
                    </span>

                </div>

                <!-- TELÉFONO -->
                <div class="col-md-6 mb-3">

                    <label class="fw-semibold d-block">
                        Teléfono
                    </label>

                    <span class="text-secondary">
                        @Model.Telefono
                    </span>

                </div>

                <!-- ESTADO DEL CLIENTE -->
                <div class="col-md-12 mb-3">

                    <label class="fw-semibold d-block">
                        Estado
                    </label>

                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inactivo
                        </span>
                    }

                </div>

            </div>

            <!-- BOTONES DE CONFIRMACIÓN -->
            <div class="d-flex justify-content-end gap-2 mt-4">

                <!-- CANCELAR OPERACIÓN -->
                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    Cancelar
                </a>

                <!-- FORMULARIO DE ELIMINACIÓN -->
                <form asp-controller="Clientes"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- CONFIRMAR ELIMINACIÓN -->
                    <button type="submit"
                            class="btn btn-danger px-4">
                        Confirmar Eliminación
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>
