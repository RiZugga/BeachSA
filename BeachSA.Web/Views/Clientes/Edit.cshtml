@model BeachSA.Web.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Editar Cliente";
}

<!-- SECCIÓN PRINCIPAL DE EDICIÓN -->
<section class="container-fluid">

    <!-- ENCABEZADO DE LA PÁGINA -->
    <div class="mb-4">

        <h1 class="fw-bold mb-1">
            Editar Cliente
        </h1>

        <p class="text-secondary">
            Modifique la información del cliente seleccionado.
        </p>

    </div>

    <!-- TARJETA DEL FORMULARIO -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <!-- FORMULARIO DE EDICIÓN -->
            <form asp-controller="Clientes"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <!-- IDENTIFICADOR DEL CLIENTE -->
                <input type="hidden" asp-for="Id" />

                <!-- VALIDACIONES GENERALES -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- INFORMACIÓN DE IDENTIFICACIÓN -->
                <h5 class="fw-bold mb-3">
                    Información de Identificación
                </h5>

                <div class="row">

                    <!-- TIPO DE CÉDULA -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="TipoCedula"
                               class="form-label">
                        </label>

                        <select asp-for="TipoCedula"
                                class="form-select">

                            <option value="">
                                Seleccione una opción
                            </option>

                            <option value="Nacional">
                                Nacional
                            </option>

                            <option value="Residencia">
                                Residencia
                            </option>

                            <option value="Pasaporte">
                                Pasaporte
                            </option>

                        </select>

                        <span asp-validation-for="TipoCedula"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- NÚMERO DE CÉDULA -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Cedula"
                               class="form-label">
                        </label>

                        <input asp-for="Cedula"
                               class="form-control" />

                        <span asp-validation-for="Cedula"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- INFORMACIÓN PERSONAL -->
                <h5 class="fw-bold mt-4 mb-3">
                    Información Personal
                </h5>

                <div class="row">

                    <!-- NOMBRE COMPLETO -->
                    <div class="col-md-12 mb-3">

                        <label asp-for="NombreCompleto"
                               class="form-label">
                        </label>

                        <input asp-for="NombreCompleto"
                               class="form-control" />

                        <span asp-validation-for="NombreCompleto"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- TELÉFONO -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Telefono"
                               class="form-label">
                        </label>

                        <input asp-for="Telefono"
                               class="form-control" />

                        <span asp-validation-for="Telefono"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- CORREO ELECTRÓNICO -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- DIRECCIÓN -->
                    <div class="col-md-12 mb-4">

                        <label asp-for="Direccion"
                               class="form-label">
                        </label>

                        <textarea asp-for="Direccion"
                                  class="form-control"
                                  rows="3"></textarea>

                        <span asp-validation-for="Direccion"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- BOTONES DEL FORMULARIO -->
                <div class="d-flex justify-content-end gap-2">

                    <!-- CANCELAR EDICIÓN -->
                    <a asp-controller="Clientes"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>

                    <!-- GUARDAR CAMBIOS -->
                    <button type="submit"
                            class="btn text-white px-4"
                            style="background-color: var(--beach-turquoise);">
                        Guardar Cambios
                    </button>

                </div>

            </form>

        </div>

    </div>

</section>

<!-- SCRIPTS DE VALIDACIÓN -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
