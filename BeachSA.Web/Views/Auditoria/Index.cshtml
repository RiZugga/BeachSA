@using BeachSA.Web.Dtos
@model AuditoriaResultadoDto
@{
    ViewData["Title"] = "Auditoría";
    var filtro = ViewBag.Filtro as AuditoriaFiltroDto ?? new AuditoriaFiltroDto();
    var acciones = new[] { "Login", "LoginFallido", "Crear", "Modificar", "Eliminar" };
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Auditoría</h2>
        <span class="text-muted small">Total de registros: @Model.Total</span>
    </div>

    <form method="get" asp-action="Index" class="card card-body mb-4">
        <input type="hidden" name="Pagina" value="1" />
        <input type="hidden" name="TamanoPagina" value="@filtro.TamanoPagina" />

        <div class="row g-3">
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" name="Desde" class="form-control"
                       value="@(filtro.Desde?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" name="Hasta" class="form-control"
                       value="@(filtro.Hasta?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Usuario</label>
                <input type="text" name="NombreUsuario" class="form-control"
                       placeholder="Ej. admin" value="@filtro.NombreUsuario" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Acción</label>
                <select name="Accion" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var acc in acciones)
                    {
                        <option value="@acc" selected="@(filtro.Accion == acc)">@acc</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Entidad</label>
                <input type="text" name="Entidad" class="form-control"
                       placeholder="Ej. Usuario, Cliente..." value="@filtro.Entidad" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Entidad</th>
                    <th>ID Entidad</th>
                    <th>Detalle</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No hay registros de auditoría para mostrar.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@item.NombreUsuario</td>
                            <td><span class="badge bg-secondary">@item.Accion</span></td>
                            <td>@(item.Entidad ?? "-")</td>
                            <td>@(item.EntidadId ?? "-")</td>
                            <td>@(item.Detalle ?? "-")</td>
                            <td>@(item.DireccionIp ?? "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted small">
                Página @Model.Pagina de @Model.TotalPaginas
            </span>

            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary btn-sm @(Model.Pagina <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-Desde="@(filtro.Desde?.ToString("yyyy-MM-dd"))"
                   asp-route-Hasta="@(filtro.Hasta?.ToString("yyyy-MM-dd"))"
                   asp-route-NombreUsuario="@filtro.NombreUsuario"
                   asp-route-Accion="@filtro.Accion"
                   asp-route-Entidad="@filtro.Entidad"
                   asp-route-Pagina="@(Model.Pagina - 1)"
                   asp-route-TamanoPagina="@Model.TamanoPagina">
                    Anterior
                </a>

                <a class="btn btn-outline-primary btn-sm @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-Desde="@(filtro.Desde?.ToString("yyyy-MM-dd"))"
                   asp-route-Hasta="@(filtro.Hasta?.ToString("yyyy-MM-dd"))"
                   asp-route-NombreUsuario="@filtro.NombreUsuario"
                   asp-route-Accion="@filtro.Accion"
                   asp-route-Entidad="@filtro.Entidad"
                   asp-route-Pagina="@(Model.Pagina + 1)"
                   asp-route-TamanoPagina="@Model.TamanoPagina">
                    Siguiente
                </a>
            </div>
        </nav>
    }
</div>