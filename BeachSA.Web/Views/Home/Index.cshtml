
@{
    ViewData["Title"] = "Inicio";
}

<!-- Sección Principal del Dashboard -->
<section class="container-fluid">

    <!-- Tarjeta de Bienvenida -->
    <div class="row align-items-center bg-white rounded-4 shadow-sm overflow-hidden">

        <!-- Información de Bienvenida -->
        <div class="col-lg-7 p-5">

            <h1 class="display-5 fw-bold mb-3">
                Bienvenido a Beach S.A.
            </h1>

            <h4 class="text-secondary mb-4">
                Sistema de Gestión de Paquetes Vacacionales
            </h4>

            <p class="text-secondary mb-4">
                Administra clientes, paquetes vacacionales,
                reservaciones y usuarios desde una plataforma
                centralizada, organizada y segura.
            </p>

            <!-- Botón de Navegación -->
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-lg text-white px-4"
               style="background-color: var(--beach-turquoise);">
                Explorar el sistema
            </a>

        </div>

        <!-- Imagen Principal del Dashboard -->
        <div class="col-lg-5 p-4">

          <img src="~/images/BeachImage.jpg" alt="Playa tropical Beach S.A." class="img-fluid rounded-4 w-100" style="height: 320px; object-fit: cover;" />

        </div>

    </div>

</section>
