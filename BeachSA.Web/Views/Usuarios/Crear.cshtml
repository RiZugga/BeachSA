@model BeachSA.Web.ViewModels.UsuarioCreateViewModel

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="container py-3" style="max-width: 720px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Crear usuario</h2>
            <small class="text-muted">Completa los datos para registrar un nuevo usuario</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NombreUsuario" class="form-label"></label>
                        <input asp-for="NombreUsuario" class="form-control" maxlength="50" />
                        <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Rol" class="form-label"></label>
                        <select asp-for="Rol"
                                asp-items="@(new SelectList(Model.RolesDisponibles))"
                                class="form-select">
                            <option value="">-- Seleccione un rol --</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <input asp-for="NombreCompleto" class="form-control" maxlength="100" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" maxlength="100" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Mínimo 8 caracteres.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Cedula" class="form-label"></label>
                        <input asp-for="Cedula" type="text" class="form-control" maxlength="20" />
                        <span asp-validation-for="Cedula" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TipoCedula" class="form-label"></label>
                        <input asp-for="TipoCedula" type="text" class="form-control" maxlength="20" />
                        <span asp-validation-for="TipoCedula" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" type="text" class="form-control" maxlength="20" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Direccion" class="form-label"></label>
                        <input asp-for="Direccion" type="text" class="form-control" maxlength="250" />
                        <span asp-validation-for="Direccion" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="Activo" class="form-check-input" />
                            <label asp-for="Activo" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}