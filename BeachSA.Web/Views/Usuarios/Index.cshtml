@model BeachSA.Web.ViewModels.UsuarioIndexViewModel

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
        <div>
            <h2 class="mb-0">Gestión de Usuarios</h2>
            <small class="text-muted">Administración de cuentas, estados y roles de usuario</small>
        </div>
        <a asp-action="Crear" class="btn btn-primary">
            + Nuevo usuario
        </a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-8 col-lg-9">
                    <input type="text"
                           name="filtro"
                           value="@Model.Filtro"
                           class="form-control"
                           placeholder="Buscar por nombre de usuario, nombre completo o correo..." />
                </div>
                <div class="col-md-4 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary w-100">Buscar</button>
                    @if (!string.IsNullOrWhiteSpace(Model.Filtro))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Nombre completo</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Fecha creación</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Usuarios.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    No se encontraron usuarios con el criterio indicado.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var u in Model.Usuarios)
                            {
                                <tr>
                                    <td>@u.Id</td>
                                    <td class="fw-semibold">@u.NombreUsuario</td>
                                    <td>@u.NombreCompleto</td>
                                    <td>@u.Email</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@u.Rol</span>
                                    </td>
                                    <td>
                                        @if (u.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td>@u.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                            <a asp-action="Editar" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>
                                            <a asp-action="AsignarRol" asp-route-id="@u.Id" class="btn btn-sm btn-outline-dark">
                                                Rol
                                            </a>
                                            <form asp-action="Eliminar"
                                                  asp-route-id="@u.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Deseas eliminar al usuario @u.NombreUsuario?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Eliminar
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>