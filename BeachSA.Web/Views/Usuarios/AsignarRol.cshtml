@model BeachSA.Web.ViewModels.AsignarRolViewModel

@{
    ViewData["Title"] = "Asignar rol";
}

<div class="container py-3" style="max-width: 560px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Asignar rol</h2>
            <small class="text-muted">Cambia el rol asignado al usuario</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="mb-3 p-3 bg-light rounded">
                <div><strong>Usuario:</strong> @Model.NombreUsuario</div>
                <div><strong>Nombre completo:</strong> @Model.NombreCompleto</div>
            </div>

            <form asp-action="AsignarRol" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="NombreUsuario" type="hidden" />
                <input asp-for="NombreCompleto" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Rol" class="form-label"></label>
                    <select asp-for="Rol"
                            asp-items="@(new SelectList(Model.RolesDisponibles))"
                            class="form-select">
                        <option value="">-- Seleccione un rol --</option>
                    </select>
                    <span asp-validation-for="Rol" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Actualizar rol</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}