@model BeachSA.Web.ViewModels.PagoReservacionViewModel

@{
    ViewData["Title"] = "Crear pago de reservación";
}

<div class="container py-3" style="max-width: 720px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Crear pago de reservación</h2>
            <small class="text-muted">Completa los datos para registrar un nuevo pago de reservación</small>
        </div>
        <a asp-action="Index" asp-controller="PagoReservacion" class="btn btn-outline-secondary">Volver</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model?.Reservacion != null)
            {
                <div class="alert alert-info mb-3">
                    <strong>Reservación:</strong> ID #@Model.Reservacion.Id
                </div>
            }
            
            <form asp-controller="PagoReservacion" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ReservacionId" class="form-label"></label>
                        <input asp-for="ReservacionId" class="form-control" readonly />
                        <span asp-validation-for="ReservacionId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="NumeroMensualidad" class="form-label"></label>
                        <input asp-for="NumeroMensualidad" class="form-control" />
                        <span asp-validation-for="NumeroMensualidad" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Monto" class="form-label"></label>
                        <input asp-for="Monto" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Monto" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Moneda" class="form-label"></label>
                        <select asp-for="Moneda" class="form-select">
                            <option value="">Seleccione una moneda</option>
                            <option value="USD">USD</option>
                            <option value="CRC">CRC</option>
                        </select>
                        <span asp-validation-for="Moneda" class="text-danger small"></span>
                    </div>

                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" asp-controller="PagoReservacion" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar pago</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
