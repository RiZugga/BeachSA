@model BeachSA.Web.Models.Reservacion

@{
    ViewData["Title"] = "Delete";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Eliminar Reservación</h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong>¿Está seguro de que desea eliminar esta reservación?</strong>
                    <div class="small">
                        Esta acción podría afectar el historial de reservaciones.
                    </div>
                </div>
            </div>

            <h5 class="fw-semibold mb-3">Información general</h5>

            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Número de reservación</label>
                    <p class="fw-semibold mb-0">#@Model.Id</p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Cliente</label>
                    <p class="mb-0">@Model.ClienteId</p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Paquete</label>
                    <p class="mb-0">@Model.PaqueteId</p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Usuario responsable</label>
                    <p class="mb-0">@Model.UsuarioId</p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Cantidad de personas</label>
                    <p class="mb-0">@Model.CantidadPersonas</p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Cantidad de noches</label>
                    <p class="mb-0">@Model.CantidadNoches</p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Fecha de creación</label>
                    <p class="mb-0">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="fw-semibold mb-3">Información del pago</h5>

            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Forma de pago</label>
                    <p class="mb-0">@Model.FormaPago</p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Número de cheque</label>
                    <p class="mb-0">@(Model.NumeroCheque ?? "No aplica")</p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Banco</label>
                    <p class="mb-0">@(Model.Banco ?? "No aplica")</p>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="fw-semibold mb-3">Resumen financiero</h5>

            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Subtotal</label>
                    <p class="mb-0">
                        @Model.Subtotal.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Descuento</label>
                    <p class="mb-0">
                        @Model.MontoDescuento.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">IVA</label>
                    <p class="mb-0">
                        @Model.MontoIva.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Total en dólares</label>
                    <p class="fw-semibold mb-0">
                        @Model.TotalUsd.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Total en colones</label>
                    <p class="fw-semibold mb-0">
                        @Model.TotalColones.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-CR"))
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Tipo de cambio</label>
                    <p class="mb-0">@Model.TipoCambio.ToString("N2")</p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Prima</label>
                    <p class="mb-0">
                        @Model.MontoPrima.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Saldo pendiente</label>
                    <p class="mb-0">
                        @Model.Saldo.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Mensualidad</label>
                    <p class="mb-0">
                        @Model.MontoMensualidad.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                    </p>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="fw-semibold mb-3">Notificación por correo</h5>

            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Estado del correo</label>
                    <p class="mb-0">
                        @if (Model.CorreoEnviado)
                        {
                            <span class="badge bg-success">Enviado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pendiente</span>
                        }
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Fecha de envío</label>
                    <p class="mb-0">
                        @(Model.FechaCorreo?.ToString("dd/MM/yyyy HH:mm") ?? "No enviado")
                    </p>
                </div>
            </div>

            <hr class="my-4" />

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Volver
                    </a>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>
                        Confirmar eliminación
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
