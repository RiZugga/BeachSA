@model IEnumerable<BeachSA.Web.Models.Reservacion>

@{
    ViewData["Title"] = "Reservaciones";
}

<div class="container-fluid py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
        <div>
            <h2 class="mb-0">Gestión de Reservaciones</h2>
            <small class="text-muted">Administración de reservaciones, clientes y paquetes registrados</small>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Paquete</th>
                            <th>Personas</th>
                            <th>Noches</th>
                            <th>Forma de pago</th>
                            <th>Total USD</th>
                            <th>Total CRC</th>
                            <th>Fecha creación</th>
                            <th>Correo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-center py-4 text-muted">
                                    No hay reservaciones registradas.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">#@r.Id</td>

                                    <td>@r.ClienteId</td>

                                    <td>@r.PaqueteId</td>

                                    <td>@r.CantidadPersonas</td>

                                    <td>@r.CantidadNoches</td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @r.FormaPago
                                        </span>
                                    </td>

                                    <td>
                                        @r.TotalUsd.ToString("C2",
                                            System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                    </td>

                                    <td>
                                        @r.TotalColones.ToString("C2",
                                            System.Globalization.CultureInfo.GetCultureInfo("es-CR"))
                                    </td>

                                    <td>@r.FechaCreacion.ToString("dd/MM/yyyy")</td>

                                    <td>
                                        @if (r.CorreoEnviado)
                                        {
                                            <span class="badge bg-success">Enviado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pendiente</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex flex-wrap justify-content-end gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@r.Id"
                                               class="btn btn-sm btn-outline-info">
                                                Detalles
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@r.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@r.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Cancelar
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
