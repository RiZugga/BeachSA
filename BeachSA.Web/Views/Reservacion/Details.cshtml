
@model BeachSA.Web.Models.Reservacion

@{
    ViewData["Title"] = "Details";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Detalles de la Reservación</h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-semibold mb-3">Información general</h5>

            <dl class="row">

                <dt class="col-sm-3">Número de reservación</dt>
                <dd class="col-sm-9">#@Model.Id</dd>

                <dt class="col-sm-3">Cliente</dt>
                <dd class="col-sm-9">@Model.ClienteId</dd>

                <dt class="col-sm-3">Paquete</dt>
                <dd class="col-sm-9">@Model.PaqueteId</dd>

                <dt class="col-sm-3">Usuario responsable</dt>
                <dd class="col-sm-9">@Model.UsuarioId</dd>

                <dt class="col-sm-3">Cantidad de personas</dt>
                <dd class="col-sm-9">@Model.CantidadPersonas</dd>

                <dt class="col-sm-3">Cantidad de noches</dt>
                <dd class="col-sm-9">@Model.CantidadNoches</dd>

                <dt class="col-sm-3">Fecha de creación</dt>
                <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>

            </dl>

            <hr class="my-4" />

            <h5 class="fw-semibold mb-3">Información del pago</h5>

            <dl class="row">

                <dt class="col-sm-3">Forma de pago</dt>
                <dd class="col-sm-9">@Model.FormaPago</dd>

                <dt class="col-sm-3">Número de cheque</dt>
                <dd class="col-sm-9">@(Model.NumeroCheque ?? "No aplica")</dd>

                <dt class="col-sm-3">Banco</dt>
                <dd class="col-sm-9">@(Model.Banco ?? "No aplica")</dd>

            </dl>

            <hr class="my-4" />

            <h5 class="fw-semibold mb-3">Información de la cotización</h5>

            <dl class="row">

                <dt class="col-sm-3">Precio por persona la noche</dt>
                <dd class="col-sm-9">
                    @Model.PrecioPersonaNoche.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </dd>

                <dt class="col-sm-3">Porcentaje de prima</dt>
                <dd class="col-sm-9">@Model.PorcentajePrima%</dd>

                <dt class="col-sm-3">Cantidad de mensualidades</dt>
                <dd class="col-sm-9">@Model.CantidadMensualidades</dd>

                <dt class="col-sm-3">Subtotal</dt>
                <dd class="col-sm-9">
                    @Model.Subtotal.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </dd>

                <dt class="col-sm-3">Porcentaje de descuento</dt>
                <dd class="col-sm-9">@Model.PorcentajeDescuento%</dd>

                <dt class="col-sm-3">Monto de descuento</dt>
                <dd class="col-sm-9">
                    @Model.MontoDescuento.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </dd>

                <dt class="col-sm-3">Porcentaje de IVA</dt>
                <dd class="col-sm-9">@Model.PorcentajeIva%</dd>

                <dt class="col-sm-3">Monto de IVA</dt>
                <dd class="col-sm-9">
                    @Model.MontoIva.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </dd>

            </dl>

            <hr class="my-4" />

            <h5 class="fw-semibold mb-3">Resumen financiero</h5>

            <dl class="row">

                <dt class="col-sm-3">Total en dólares</dt>
                <dd class="col-sm-9 fw-semibold">
                    @Model.TotalUsd.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </dd>

                <dt class="col-sm-3">Tipo de cambio</dt>
                <dd class="col-sm-9">@Model.TipoCambio</dd>

                <dt class="col-sm-3">Total en colones</dt>
                <dd class="col-sm-9 fw-semibold">
                    @Model.TotalColones.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("es-CR"))
                </dd>

                <dt class="col-sm-3">Monto de la prima</dt>
                <dd class="col-sm-9">
                    @Model.MontoPrima.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </dd>

                <dt class="col-sm-3">Saldo pendiente</dt>
                <dd class="col-sm-9">
                    @Model.Saldo.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </dd>

                <dt class="col-sm-3">Monto de mensualidad</dt>
                <dd class="col-sm-9">
                    @Model.MontoMensualidad.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </dd>

            </dl>

            <hr class="my-4" />

            <h5 class="fw-semibold mb-3">Notificación por correo</h5>

            <dl class="row">

                <dt class="col-sm-3">Estado del correo</dt>
                <dd class="col-sm-9">
                    @if (Model.CorreoEnviado)
                    {
                        <span class="badge bg-success">Enviado</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pendiente</span>
                    }
                </dd>

                <dt class="col-sm-3">Fecha de envío</dt>
                <dd class="col-sm-9">
                    @(Model.FechaCorreo?.ToString("dd/MM/yyyy HH:mm") ?? "No enviado")
                </dd>

            </dl>

            <hr class="my-4" />

            <div class="d-flex gap-2 justify-content-end">

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Volver al listado
                </a>

                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn text-white"
                   style="background-color: var(--beach-turquoise);">
                    Editar Reservación
                </a>

            </div>

        </div>
    </div>

</div>
