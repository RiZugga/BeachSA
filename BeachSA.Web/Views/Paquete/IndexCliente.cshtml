
@model IEnumerable<BeachSA.Web.Models.Paquete>

@{
    ViewData["Title"] = "Paquetes Vacacionales";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold mb-2">Descubre nuestros paquetes vacacionales</h2>
        <p class="text-muted mb-0">
            Encuentra la opción ideal para disfrutar tus próximas vacaciones.
        </p>
    </div>

    <div class="row g-4">

        @if (Model != null && Model.Any(p => p.Activo))
        {
            @foreach (var item in Model.Where(p => p.Activo))
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <div class="card-body p-4 d-flex flex-column">

                            <h5 class="fw-bold mb-2">
                                @item.Nombre
                            </h5>

                            <p class="text-muted small mb-3">
                                Disfruta de una experiencia vacacional
                                con las condiciones de nuestro paquete.
                            </p>

                            <div class="mb-3">
                                <span class="text-muted small">Precio por persona la noche</span>

                                <h4 class="fw-bold mb-0" style="color: var(--beach-turquoise);">
                                    @item.PrecioPersonaNoche.ToString("C2",
                                        System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                </h4>
                            </div>

                            <hr />

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Prima requerida</span>
                                    <strong>@item.PorcentajePrima.ToString("N0")%</strong>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Mensualidades</span>
                                    <strong>@item.CantidadMensualidades</strong>
                                </div>
                            </div>

                            <div class="mt-auto pt-3">
                                <a asp-controller="Reservacion"
                                   asp-action="Create"
                                   asp-route-paqueteId="@item.Id"
                                   class="btn btn-primary">
                                    Reservar paquete
                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="bi bi-info-circle text-muted fs-1"></i>
                    <h5 class="mt-3">No hay paquetes disponibles</h5>
                    <p class="text-muted mb-0">
                        Actualmente no contamos con paquetes vacacionales disponibles.
                    </p>
                </div>
            </div>
        }

    </div>
</div>
