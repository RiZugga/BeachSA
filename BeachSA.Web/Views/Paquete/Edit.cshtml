
@model BeachSA.Web.Models.Paquete

@{
    ViewData["Title"] = "Edit";
}

<h1 class="fw-bold mb-1">Editar Paquete</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="form-label fw-semibold">
                    Nombre del paquete
                </label>

                <input asp-for="Nombre" class="form-control" />

                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PrecioPersonaNoche" class="form-label fw-semibold">
                    Precio por persona / noche (USD)
                </label>

                <input asp-for="PrecioPersonaNoche"
                       class="form-control"
                       type="number"
                       step="0.01" />

                <span asp-validation-for="PrecioPersonaNoche" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PorcentajePrima" class="form-label fw-semibold">
                    Porcentaje de prima (%)
                </label>

                <input asp-for="PorcentajePrima"
                       class="form-control"
                       type="number"
                       step="0.01" />

                <span asp-validation-for="PorcentajePrima" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CantidadMensualidades" class="form-label fw-semibold">
                    Cantidad de mensualidades
                </label>

                <input asp-for="CantidadMensualidades"
                       class="form-control"
                       type="number" />

                <span asp-validation-for="CantidadMensualidades" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 flex-wrap">

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    Volver a la lista
                </a>

                <button type="submit"
                        class="btn text-white px-4"
                        style="background-color: var(--beach-turquoise);">
                    Guardar Cambios
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
