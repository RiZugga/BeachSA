@model BeachSA.Web.ViewModels.ClienteViewModel

@{
    ViewData["Title"] = "Nuevo Cliente";
}

<!-- SECCIÓN PRINCIPAL DEL REGISTRO DE CLIENTES -->
<section class="container-fluid">

    <!-- ENCABEZADO DE LA PÁGINA -->
    <div class="mb-4">

        <h1 class="fw-bold mb-1">
            Registrar Cliente
        </h1>

        <p class="text-secondary mb-0">
            Complete la información para registrar
            un nuevo cliente en Beach S.A.
        </p>

    </div>

    <!-- TARJETA DEL FORMULARIO -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <!-- FORMULARIO DE REGISTRO -->
            <form asp-controller="Clientes"
                  asp-action="Create"
                  method="post">

                <!-- VALIDACIONES GENERALES -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- INFORMACIÓN DE IDENTIFICACIÓN -->
                <h5 class="fw-bold mb-3">
                    Información de Identificación
                </h5>

                <div class="row">

                    <!-- TIPO DE CÉDULA -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="TipoCedula"
                               class="form-label">
                        </label>

                        <select asp-for="TipoCedula"
                                class="form-select">

                            <option value="">
                                Seleccione una opción
                            </option>

                            <option value="Nacional">
                                Nacional
                            </option>

                            <option value="Residencia">
                                Residencia
                            </option>

                            <option value="Pasaporte">
                                Pasaporte
                            </option>

                        </select>

                        <span asp-validation-for="TipoCedula"
                              class="text-danger small">
                        </span>

                    </div>

                    
                    <!-- CÉDULA Y CONSULTA DE IDENTIFICACIÓN -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Cedula"
                               class="form-label">
                        </label>

                        <!-- CAMPO DE CÉDULA -->
                        <div class="input-group">

                            <input asp-for="Cedula"
                                   class="form-control"
                                   placeholder="Ingrese la cédula" />

                            <!-- CONSULTA PENDIENTE DE INTEGRACIÓN -->
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    disabled
                                    title="Disponible cuando se integre la API">
                                Consultar cédula
                            </button>

                        </div>

                        <!-- VALIDACIÓN DE CÉDULA -->
                        <span asp-validation-for="Cedula"
                              class="text-danger small">
                        </span>

                        <!-- INFORMACIÓN DE INTEGRACIÓN -->
                        <small class="text-secondary d-block mt-1">
                            La consulta automática estará disponible
                            cuando se integre el servicio de identificación.
                        </small>

                    </div>


                </div>

                <!-- INFORMACIÓN PERSONAL -->
                <h5 class="fw-bold mt-4 mb-3">
                    Información Personal
                </h5>

                <div class="row">

                    <!-- NOMBRE COMPLETO -->
                    <div class="col-md-12 mb-3">

                        <label asp-for="NombreCompleto"
                               class="form-label">
                        </label>

                        <input asp-for="NombreCompleto"
                               class="form-control"
                               placeholder="Ingrese el nombre completo" />

                        <span asp-validation-for="NombreCompleto"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- TELÉFONO -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Telefono"
                               class="form-label">
                        </label>

                        <input asp-for="Telefono"
                               class="form-control"
                               placeholder="Ingrese el teléfono" />

                        <span asp-validation-for="Telefono"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- CORREO ELECTRÓNICO -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Ingrese el correo electrónico" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- DIRECCIÓN -->
                    <div class="col-md-12 mb-4">

                        <label asp-for="Direccion"
                               class="form-label">
                        </label>

                        <textarea asp-for="Direccion"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Ingrese la dirección del cliente"></textarea>

                        <span asp-validation-for="Direccion"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- BOTONES DEL FORMULARIO -->
                <div class="d-flex justify-content-end gap-2">

                    <!-- REGRESAR AL LISTADO -->
                    <a asp-controller="Clientes"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>

                    <!-- GUARDAR CLIENTE -->
                    <button type="submit"
                            class="btn text-white px-4"
                            style="background-color: var(--beach-turquoise);">
                        Guardar Cliente
                    </button>

                </div>

            </form>

        </div>

    </div>

</section>

<!-- SCRIPTS DE VALIDACIÓN -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
